# ilias-mcp Konfiguration
# Diese Datei nur als Vorlage nutzen, eigene Werte in .env (nicht committen).

# Welche Instanz angesprochen wird (siehe config.toml): hhn, uni-mannheim, hs-mannheim
ILIAS_INSTANCE=hhn

# Zugangsdaten NUR hierüber, niemals im Code oder im Repo.
# Für HS-Mannheim (Moodle) reicht ILIAS_PASSWORD, falls der Webservice-Token
# direkt eingespielt wird. Sonst wird das CLI-Passwort verwendet, um den Token
# per REST zu holen (mobile/webservice/rest/server.php).
ILIAS_USERNAME=
ILIAS_PASSWORD=

# Optional: TOTP-Secret für HHN-Keycloak (Base32). Wenn leer, fordert der Server
# den Code zur Laufzeit per Tool-Aufruf an (kein TOTP-Backend aktivierbar).
# ACHTUNG: TOTP_SECRET im Klartext ist heikel - das OS-Keyring ist sicherer.
ILIAS_TOTP_SECRET=

# Optional: Konfigurationsverzeichnis (Default: ~/.config/ilias-cli)
# ILIAS_CLI_CONFIG_DIR=

# Optional: Browser-Login erzwingen (Playwright muss installiert sein).
# ILIAS_LOGIN_BROWSER=0